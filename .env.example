# Core App Settings
APP_NAME=IPL Smart Bets Bot
APP_ENV=development
DATABASE_URL=sqlite:///./ipl_smart_bets.db
PORT=8000

# Cricket Data (Stats)
CRICKET_DATA_API_KEY=your_key_here
CRICKET_DATA_BASE_URL=https://api.cricapi.com/v1

# The-Odds-API (Odds)
THE_ODDS_API_KEY=your_key_here
THE_ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
THE_ODDS_API_SPORT_KEY=cricket_ipl
THE_ODDS_API_REGION=eu
THE_ODDS_API_MARKETS=h2h

# Bot Settings
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_SECRET=choose-a-secret-path-token
MIN_EDGE=0.05
MAX_KELLY_FRACTION=0.25
LIVE_SCAN_INTERVAL_SECONDS=60