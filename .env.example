APP_NAME=IPL Smart Bets Bot
APP_ENV=development
DATABASE_URL=sqlite:///./ipl_smart_bets.db
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=choose-a-secret-path-token
TELEGRAM_WEBHOOK_URL=
DEFAULT_BANKROLL=10000
MIN_EDGE=0.05
MAX_KELLY_FRACTION=0.25
SCHEDULER_ENABLED=true
CRICSHEET_IPL_URL=https://cricsheet.org/downloads/ipl_json.zip
IPL_DATA_ZIP_PATH=data/ipl/ipl_json.zip
MODEL_ARTIFACT_PATH=artifacts/model_bundle.joblib
CRICKET_DATA_API_KEY=
CRICKET_DATA_BASE_URL=https://api.cricapi.com/v1
AUTO_TRAIN_MODEL_ON_START=true
AUTO_REFRESH_DATA_ON_START=false
PORT=8000
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
BETFAIR_LOGIN_URL=https://identitysso.betfair.com/api/login
BETFAIR_BETTING_URL=https://api.betfair.com/exchange/betting/json-rpc/v1
LIVE_SCAN_INTERVAL_SECONDS=60
